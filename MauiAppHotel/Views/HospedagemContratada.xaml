<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Reserva confirmada"
             BackgroundColor="{StaticResource Fundo}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="Reserva confirmada!" Style="{StaticResource Titulo}" Margin="0,0,0,6" />

            <Label Text="{Binding Hospede, StringFormat='Hóspede: {0}'}" />
            <Label Text="{Binding QuartoDescricao, StringFormat='Quarto: {0}'}" />
            <Label Text="{Binding Ocupacao, StringFormat='Ocupação: {0}'}" />
            <Label Text="{Binding Periodo, StringFormat='Período: {0}'}" />
            <Label Text="{Binding ValorFormatado, StringFormat='Valor total: {0}'}"
                   FontAttributes="Bold" FontSize="18"
                   TextColor="{StaticResource Destaque}" Margin="0,10" />

            <Button Text="Nova reserva" Clicked="OnNovaReservaClicked" />
            <Button Text="Ver reservas" Clicked="OnVerReservasClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
